<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SweaxClip.Core"
                    xmlns:ui="clr-namespace:SweaxClip.UI">

    <ui:BoolToVis x:Key="Vis"/>
    <ui:BoolToVis x:Key="NotVis" Invert="True"/>
    <ui:UpperConverter x:Key="Upper"/>

    <!-- ── context menu for any card ───────────────────────────────────────── -->
    <ContextMenu x:Key="ClipMenu" x:Shared="False">
        <MenuItem Header="{c:T Paste}" Tag="&#xE77F;" InputGestureText="Enter" Command="{x:Static ui:Cmds.Paste}" CommandParameter="{Binding}"/>
        <MenuItem Header="{c:T PastePlain}" Tag="&#xE8D2;" InputGestureText="Shift+Enter" Command="{x:Static ui:Cmds.PastePlain}" CommandParameter="{Binding}"/>
        <MenuItem Header="{c:T CopyOnly}" Tag="&#xE8C8;" InputGestureText="Ctrl+C" Command="{x:Static ui:Cmds.Copy}" CommandParameter="{Binding}"/>
        <Separator/>
        <MenuItem Header="{c:T Pin}" Tag="&#xE718;" InputGestureText="Ctrl+P" Command="{x:Static ui:Cmds.TogglePin}" CommandParameter="{Binding}"/>
        <MenuItem Header="{c:T OpenFile}" Tag="&#xE8A7;" InputGestureText="Ctrl+O" Command="{x:Static ui:Cmds.Open}" CommandParameter="{Binding}"/>
        <MenuItem Header="{c:T ShowInFolder}" Tag="&#xE838;" Command="{x:Static ui:Cmds.ShowInFolder}" CommandParameter="{Binding}"/>
        <MenuItem Header="{c:T SaveImage}" Tag="&#xE74E;" Command="{x:Static ui:Cmds.SaveImage}" CommandParameter="{Binding}"/>
        <Separator/>
        <MenuItem Header="{c:T Delete}" Tag="&#xE74D;" InputGestureText="Delete" Command="{x:Static ui:Cmds.Delete}" CommandParameter="{Binding}"/>
    </ContextMenu>

    <!-- ── day label on the desk ───────────────────────────────────────────── -->
    <DataTemplate x:Key="Header" DataType="{x:Type c:HeaderRow}">
        <StackPanel Orientation="Horizontal" Margin="30,22,24,14">
            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
            <TextBlock Text="{Binding Sub}" FontSize="12.5" Foreground="{DynamicResource Ink3}" Margin="10,2,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <!-- ── a card lying on the desk; it lifts when you reach for it ───────── -->
    <DataTemplate x:Key="Tile" DataType="{x:Type c:ClipItem}">
        <Grid Margin="7,7,15,15" Background="Transparent" Cursor="Hand" ContextMenu="{StaticResource ClipMenu}" x:Name="tile">
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{x:Static ui:Cmds.Select}" CommandParameter="{Binding}"/>
                <MouseBinding Gesture="LeftDoubleClick" Command="{x:Static ui:Cmds.Copy}" CommandParameter="{Binding}"/>
            </Grid.InputBindings>
            <Grid x:Name="lift" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="zoom"/>
                        <TranslateTransform x:Name="raise"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.Effect>
                    <DropShadowEffect x:Name="shadow" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.16" Color="#2A1A0E"/>
                </Grid.Effect>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource Cards}"/>
                </Viewbox>
                <Border x:Name="ring" BorderBrush="{DynamicResource Accent}" BorderThickness="2.5" CornerRadius="13" Margin="-5" Visibility="Hidden" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <EventTrigger SourceName="tile" RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="raise" Storyboard.TargetProperty="Y" To="-6" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.28"/>
                        <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.28"/>
                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius" To="30" Duration="0:0:0.28"/>
                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="12" Duration="0:0:0.28"/>
                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0.28" Duration="0:0:0.28"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger SourceName="tile" RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="raise" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"/>
                        <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"/>
                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius" To="16" Duration="0:0:0.3"/>
                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="4" Duration="0:0:0.3"/>
                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.3"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="GridRow" DataType="{x:Type c:GridRow}">
        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Tile}" Margin="23,0,8,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding Columns}"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>
</ResourceDictionary>
