<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SweaxClip.Core"
                    xmlns:ui="clr-namespace:SweaxClip.UI">

    <ui:BodySelector x:Key="Body"/>
    <ui:BoolToVis x:Key="Vis"/>
    <ui:BoolToVis x:Key="NotVis" Invert="True"/>
    <ui:UpperConverter x:Key="Upper"/>

    <!-- ── bodies, one per kind ──────────────────────────────────────────────── -->
    <DataTemplate x:Key="Body.Text" DataType="{x:Type c:ClipItem}">
        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="57" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                   FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource Text}"/>
    </DataTemplate>

    <DataTemplate x:Key="Body.Link" DataType="{x:Type c:ClipItem}">
        <StackPanel>
            <TextBlock Text="{Binding LinkHost}" FontFamily="{StaticResource UiFont}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding LinkRest}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                       Visibility="{Binding LinkRest, Converter={StaticResource Vis}}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Body.Code" DataType="{x:Type c:ClipItem}">
        <Border Background="{StaticResource Bg0}" BorderBrush="{StaticResource Line2}" BorderThickness="1,0,0,0" Padding="10,7,8,7">
            <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#D8D8CF" MaxHeight="88" LineHeight="17"
                       Typography.StandardLigatures="False" Typography.ContextualAlternates="False"
                       LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Body.Color" DataType="{x:Type c:ClipItem}">
        <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" Background="{Binding Swatch}" BorderBrush="#30FFFFFF" BorderThickness="1"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource Text}" FontWeight="Medium"/>
                <TextBlock Text="{Binding ColorDetail}" Style="{StaticResource Mono}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Body.Image" DataType="{x:Type c:ClipItem}">
        <StackPanel HorizontalAlignment="Left">
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="1" Background="{StaticResource Bg0}" HorizontalAlignment="Left" MinWidth="60" MinHeight="40">
                <Image ui:ThumbLoader.Width="380" MaxHeight="132" MaxWidth="360" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0">
                <Run Text="{Binding Dimensions, Mode=OneWay}"/><Run Text="  ·  " Foreground="{StaticResource Text4}"/><Run Text="{Binding SizeText, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Body.Files" DataType="{x:Type c:ClipItem}">
        <StackPanel Orientation="Horizontal">
            <Image Source="{Binding FileIcon}" Width="28" Height="28" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                <TextBlock Style="{StaticResource Mono}" Margin="0,3,0,0">
                    <Run Text="{Binding Stats, Mode=OneWay}"/><Run Text="  ·  " Foreground="{StaticResource Text4}"/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Body.FilesVisual" DataType="{x:Type c:ClipItem}">
        <StackPanel>
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="1" Background="{StaticResource Bg0}" HorizontalAlignment="Left">
                <Image ui:ThumbLoader.Width="380" MaxHeight="110" MaxWidth="360" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <Image Source="{Binding FileIcon}" Width="14" Height="14" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ── date header: label, hairline, full date ───────────────────────────── -->
    <DataTemplate x:Key="Header" DataType="{x:Type c:HeaderRow}">
        <Grid Margin="16,18,14,8" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource Accent}"/>
            <Border Grid.Column="1" Height="1" Background="{StaticResource Line2}" VerticalAlignment="Center" Margin="10,1,10,0"/>
            <TextBlock Grid.Column="2" Text="{Binding Sub}" Style="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Text3}"/>
        </Grid>
    </DataTemplate>

    <!-- ── context menu for any clip ─────────────────────────────────────────── -->
    <ContextMenu x:Key="ClipMenu" x:Shared="False">
        <MenuItem Header="{c:T Paste}" Tag="{x:Static c:Glyphs.Paste}" InputGestureText="Enter" Command="{x:Static ui:Cmds.Paste}" CommandParameter="{Binding}"/>
        <MenuItem Header="{c:T PastePlain}" Tag="{x:Static c:Glyphs.Text}" InputGestureText="Shift+Enter" Command="{x:Static ui:Cmds.PastePlain}" CommandParameter="{Binding}"/>
        <MenuItem Header="{c:T CopyOnly}" Tag="{x:Static c:Glyphs.Copy}" InputGestureText="Ctrl+C" Command="{x:Static ui:Cmds.Copy}" CommandParameter="{Binding}"/>
        <Separator/>
        <MenuItem Header="{c:T Pin}" Tag="{x:Static c:Glyphs.Pin}" InputGestureText="Ctrl+P" Command="{x:Static ui:Cmds.TogglePin}" CommandParameter="{Binding}"/>
        <MenuItem Header="{c:T OpenFile}" Tag="{x:Static c:Glyphs.Open}" InputGestureText="Ctrl+O" Command="{x:Static ui:Cmds.Open}" CommandParameter="{Binding}"/>
        <MenuItem Header="{c:T ShowInFolder}" Tag="{x:Static c:Glyphs.Folder}" Command="{x:Static ui:Cmds.ShowInFolder}" CommandParameter="{Binding}"/>
        <MenuItem Header="{c:T SaveImage}" Tag="{x:Static c:Glyphs.Save}" Command="{x:Static ui:Cmds.SaveImage}" CommandParameter="{Binding}"/>
        <Separator/>
        <MenuItem Header="{c:T Delete}" Tag="{x:Static c:Glyphs.Trash}" InputGestureText="Del" Command="{x:Static ui:Cmds.Delete}" CommandParameter="{Binding}"/>
    </ContextMenu>

    <!-- ── quick panel row ───────────────────────────────────────────────────── -->
    <DataTemplate x:Key="Row.Panel" DataType="{x:Type c:ClipItem}">
        <Border x:Name="row" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Cursor="Hand" ContextMenu="{StaticResource ClipMenu}">
            <Grid>
                <Grid Margin="0,11,8,11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock x:Name="glyph" Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Text3}"/>
                        <TextBlock x:Name="num" Text="{Binding IndexLabel}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" HorizontalAlignment="Center" Margin="0,7,0,0" Foreground="{StaticResource Text4}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource Body}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Image Source="{Binding AppIcon}" Width="12" Height="12" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding AppName}" Style="{StaticResource Mono}" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="  /  " Style="{StaticResource Mono}" Foreground="{StaticResource Text4}"/>
                            <TextBlock Text="{Binding RelTime}" Style="{StaticResource Mono}"/>
                            <TextBlock Text="{Binding UsesLabel}" Style="{StaticResource Mono}" Foreground="{StaticResource Text4}" Margin="8,0,0,0"
                                       Visibility="{Binding UsesLabel, Converter={StaticResource Vis}}"/>
                            <TextBlock x:Name="pin" Text="{x:Static c:Glyphs.Pinned}" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource Accent}" Margin="9,1,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,-5,0,0" Visibility="Hidden">
                        <Button x:Name="pinBtn" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Pin}" Width="26" Height="26" FontSize="11.5" ToolTip="Ctrl+P"
                                Command="{x:Static ui:Cmds.TogglePin}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Trash}" Width="26" Height="26" FontSize="11.5" ToolTip="Del"
                                Command="{x:Static ui:Cmds.Delete}" CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
                <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Background="{StaticResource Accent}" Visibility="Hidden"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                <Setter TargetName="row" Property="Background" Value="{StaticResource Bg1}"/>
                <Setter TargetName="actions" Property="Visibility" Value="Visible"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="row" Property="Background" Value="{StaticResource Bg2}"/>
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter TargetName="num" Property="Foreground" Value="{StaticResource Text2}"/>
                <Setter TargetName="actions" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Pinned}" Value="True">
                <Setter TargetName="pin" Property="Visibility" Value="Visible"/>
                <Setter TargetName="pinBtn" Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter TargetName="pinBtn" Property="Content" Value="{x:Static c:Glyphs.Pinned}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── library list row: wider, with a metadata column ───────────────────── -->
    <DataTemplate x:Key="Row.Library" DataType="{x:Type c:ClipItem}">
        <Border x:Name="row" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Cursor="Hand" ContextMenu="{StaticResource ClipMenu}">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{x:Static ui:Cmds.Select}" CommandParameter="{Binding}"/>
                <MouseBinding Gesture="LeftDoubleClick" Command="{x:Static ui:Cmds.Copy}" CommandParameter="{Binding}"/>
            </Border.InputBindings>
            <Grid>
                <Grid Margin="0,13,12,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="glyph" Text="{Binding KindGlyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Text3}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplateSelector="{StaticResource Body}" Margin="0,0,24,0"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding AppIcon}" Width="13" Height="13" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding AppName}" Style="{StaticResource Mono}" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Mono}" Margin="0,5,0,0">
                            <Run Text="{Binding RelTime, Mode=OneWay}"/><Run Text="  /  " Foreground="{StaticResource Text4}"/><Run Text="{Binding KindLabel, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel x:Name="actions" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-5,0,0" Visibility="Hidden">
                        <Button x:Name="pinBtn" Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Pin}" Width="28" Height="28" FontSize="12" ToolTip="Ctrl+P"
                                Command="{x:Static ui:Cmds.TogglePin}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Copy}" Width="28" Height="28" FontSize="12" ToolTip="Ctrl+C"
                                Command="{x:Static ui:Cmds.Copy}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource IconButton}" Content="{x:Static c:Glyphs.Trash}" Width="28" Height="28" FontSize="12" ToolTip="Del"
                                Command="{x:Static ui:Cmds.Delete}" CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
                <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Background="{StaticResource Accent}" Visibility="Hidden"/>
                <TextBlock x:Name="pin" Text="{x:Static c:Glyphs.Pinned}" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource Accent}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="21,0,0,14" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                <Setter TargetName="row" Property="Background" Value="{StaticResource Bg1}"/>
                <Setter TargetName="actions" Property="Visibility" Value="Visible"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="row" Property="Background" Value="{StaticResource Bg2}"/>
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Pinned}" Value="True">
                <Setter TargetName="pin" Property="Visibility" Value="Visible"/>
                <Setter TargetName="pinBtn" Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter TargetName="pinBtn" Property="Content" Value="{x:Static c:Glyphs.Pinned}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── contact-sheet tile ────────────────────────────────────────────────── -->
    <DataTemplate x:Key="Tile" DataType="{x:Type c:ClipItem}">
        <Grid Margin="0,0,12,12" Cursor="Hand" ContextMenu="{StaticResource ClipMenu}" Background="Transparent">
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{x:Static ui:Cmds.Select}" CommandParameter="{Binding}"/>
                <MouseBinding Gesture="LeftDoubleClick" Command="{x:Static ui:Cmds.Copy}" CommandParameter="{Binding}"/>
            </Grid.InputBindings>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="frame" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line2}" BorderThickness="1" Height="156" ClipToBounds="True">
                <Image ui:ThumbLoader.Width="300" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <Border x:Name="ring" BorderBrush="{StaticResource Accent}" BorderThickness="2" Height="156" Visibility="Hidden" IsHitTestVisible="False"/>
            <Border x:Name="badge" Background="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Padding="5,3" Visibility="Collapsed">
                <TextBlock Text="{x:Static c:Glyphs.Pinned}" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource AccentInk}"/>
            </Border>
            <Grid Grid.Row="1" Margin="1,8,1,0">
                <TextBlock x:Name="when" Text="{Binding RelTime}" Style="{StaticResource Mono}" Foreground="{StaticResource Text2}"/>
                <TextBlock Text="{Binding Dimensions}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                <Setter TargetName="when" Property="Foreground" Value="{StaticResource Accent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Pinned}" Value="True">
                <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="GridRow" DataType="{x:Type c:GridRow}">
        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Tile}" Margin="16,0,4,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding Columns}"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>
</ResourceDictionary>
