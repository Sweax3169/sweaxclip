<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SweaxClip.Core"
                    xmlns:ui="clr-namespace:SweaxClip.UI">

    <!--
        The Win+V panel is a timeline: a rail of times on the left, each clip shown as its content.
        A row opens on a spring when it is selected (ui:Motion.Open 0 → 1); every Reveal and Grow
        inside follows that one value, so text unfolds, pictures zoom and the details slide in together.
    -->

    <ui:PanelBodySelector x:Key="PanelBodies"/>
    <ui:Affine x:Key="Affine"/>

    <Style x:Key="RowText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>
    <Style x:Key="RowNote" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- where it came from, shown once the row is open -->
    <DataTemplate x:Key="Body.Meta" DataType="{x:Type c:ClipItem}">
        <Grid Margin="0,9,0,1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AppGlyph}" Width="14" Height="14" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding AppName}" FontSize="12" Foreground="{DynamicResource Ink2}" Margin="7,0,0,1" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding RelTime}" FontSize="12" Foreground="{DynamicResource Ink3}" Margin="8,0,0,1" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding UsesLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink3}" Margin="8,0,0,1" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Keycap}" Background="{DynamicResource Field}"><TextBlock Text="↵" FontSize="11" Foreground="{DynamicResource Ink2}"/></Border>
                <TextBlock Text="{c:T HintPaste}" FontSize="11.5" Foreground="{DynamicResource Ink3}" Margin="5,0,0,1"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- text: two lines, up to seven when open -->
    <DataTemplate x:Key="Body.Text" DataType="{x:Type c:ClipItem}">
        <StackPanel>
            <ui:Reveal Closed="40">
                <TextBlock Style="{StaticResource RowText}" MaxHeight="140" TextTrimming="CharacterEllipsis"
                           ui:Highlight.Text="{Binding Preview}" ui:Highlight.Query="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
            </ui:Reveal>
            <ui:Reveal Closed="0"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Body.Meta}"/></ui:Reveal>
        </StackPanel>
    </DataTemplate>

    <!-- link: the site's colour and name, the address when open -->
    <DataTemplate x:Key="Body.Link" DataType="{x:Type c:ClipItem}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Width="22" Height="22" CornerRadius="6" Background="{Binding SiteBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SiteInitial}" FontSize="11.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                </Border>
                <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="10,0,0,1" VerticalAlignment="Center"
                           ui:Highlight.Text="{Binding LinkHost}" ui:Highlight.Query="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                <TextBlock Grid.Column="2" Text="{Binding LinkRest}" FontSize="12.5" Foreground="{DynamicResource Ink3}" Margin="6,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}"/>
            </Grid>
            <ui:Reveal Closed="0">
                <StackPanel Margin="32,6,0,0">
                    <TextBlock Text="{Binding LinkTitle}" FontSize="12.5" Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding LinkTitle, Converter={StaticResource CVis}}"/>
                    <TextBlock Text="{Binding LinkUrl}" FontSize="11.5" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Ink3}" TextWrapping="Wrap"
                               MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Body.Meta}" Margin="-32,0,0,0"/>
                </StackPanel>
            </ui:Reveal>
        </StackPanel>
    </DataTemplate>

    <!-- code: on slate, two lines, up to eight when open -->
    <DataTemplate x:Key="Body.Code" DataType="{x:Type c:ClipItem}">
        <StackPanel>
            <Border Background="{DynamicResource Slate}" CornerRadius="9" Padding="11,8,11,8">
                <ui:Reveal Closed="36">
                    <TextBlock ui:CodeView.Source="{Binding CodeSnippet}" FontFamily="{StaticResource MonoFont}" FontSize="12" LineHeight="18"
                               LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" MaxHeight="144" Typography.StandardLigatures="False"/>
                </ui:Reveal>
            </Border>
            <ui:Reveal Closed="0"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Body.Meta}"/></ui:Reveal>
        </StackPanel>
    </DataTemplate>

    <!-- colour: the swatch grows when open -->
    <DataTemplate x:Key="Body.Color" DataType="{x:Type c:ClipItem}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <ui:Grow From="22" To="52" VerticalAlignment="Top">
                    <Border x:Name="swatch" CornerRadius="7" Background="{Binding Swatch}" BorderBrush="{DynamicResource PanelEdge}" BorderThickness="1"
                            Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"/>
                </ui:Grow>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ColorHex}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                    <ui:Reveal Closed="0">
                        <TextBlock Text="{Binding ColorDetail}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Ink3}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </ui:Reveal>
                </StackPanel>
            </Grid>
            <ui:Reveal Closed="0"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Body.Meta}"/></ui:Reveal>
        </StackPanel>
    </DataTemplate>

    <!-- images and screenshots: a strip that zooms into the picture when open -->
    <DataTemplate x:Key="Body.Picture" DataType="{x:Type c:ClipItem}">
        <StackPanel>
            <ui:Grow From="58" To="178">
                <Grid ui:Round.Radius="9" Background="{DynamicResource Field}">
                    <Image ui:ThumbLoader.Width="420" Stretch="UniformToFill" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border x:Name="marks" Visibility="Collapsed" Margin="5" IsHitTestVisible="False">
                        <Grid>
                            <Path Data="M0,9 V0 H9" Stroke="#FFFF6A3D" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Path Data="M0,0 H9 V9" Stroke="#FFFF6A3D" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Path Data="M0,0 V9 H9" Stroke="#FFFF6A3D" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Path Data="M9,0 V9 H0" Stroke="#FFFF6A3D" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" CornerRadius="6" Background="#B3000000" Padding="7,2,7,3"
                            Opacity="{Binding (ui:Motion.Open), RelativeSource={RelativeSource Self}}">
                        <TextBlock FontSize="11" Foreground="White"><Run Text="{Binding Dimensions, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SizeText, Mode=OneWay}"/></TextBlock>
                    </Border>
                </Grid>
            </ui:Grow>
            <ui:Reveal Closed="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowNote}" Margin="0,8,0,0" Visibility="{Binding HasOcr, Converter={StaticResource CVis}}"
                               ui:Highlight.Text="{Binding Ocr}" ui:Highlight.Query="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Body.Meta}"/>
                </StackPanel>
            </ui:Reveal>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Screenshot"><Setter TargetName="marks" Property="Visibility" Value="Visible"/></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- files: the first name, the rest when open -->
    <DataTemplate x:Key="Body.Files" DataType="{x:Type c:ClipItem}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="{Binding FileIcon}" Width="22" Height="22" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="10,0,8,1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ui:Highlight.Text="{Binding FirstFile}" ui:Highlight.Query="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource Field}" Padding="6,1,6,2" VerticalAlignment="Center"
                        Visibility="{Binding MoreFiles, Converter={StaticResource CVis}}">
                    <TextBlock Text="{Binding MoreFiles}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink2}"/>
                </Border>
            </Grid>
            <ui:Reveal Closed="0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding FileNames}" Margin="32,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" FontSize="12.5" Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis" Margin="0,1"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Body.Meta}"/>
                </StackPanel>
            </ui:Reveal>
        </StackPanel>
    </DataTemplate>

    <!-- a row on the timeline -->
    <DataTemplate x:Key="Row.Panel" DataType="{x:Type c:ClipItem}">
        <Grid x:Name="row" Background="Transparent" Cursor="Hand" ContextMenu="{StaticResource ClipMenu}" ui:Motion.Follow="{Binding IsSelected}">
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{x:Static ui:Cmds.Paste}" CommandParameter="{Binding}"/>
            </Grid.InputBindings>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- the open row's tint, in the clip's hue -->
            <Border x:Name="tint" Grid.Column="2" CornerRadius="12" Background="{Binding Hue}" Margin="0,2"
                    Opacity="{Binding (ui:Motion.Open), RelativeSource={RelativeSource Self}, Converter={StaticResource Affine}, ConverterParameter='0 0.1'}"/>
            <Border x:Name="edge" Grid.Column="2" CornerRadius="12" BorderBrush="{Binding Hue}" BorderThickness="1" Margin="0,2"
                    Opacity="{Binding (ui:Motion.Open), RelativeSource={RelativeSource Self}, Converter={StaticResource Affine}, ConverterParameter='0 0.26'}"/>
            <Border x:Name="hover" Grid.Column="2" CornerRadius="12" Background="{DynamicResource RowHover}" Opacity="0" Margin="0,2"/>

            <!-- time, or the Alt number -->
            <TextBlock x:Name="time" Text="{Binding RelShort}" FontSize="11" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,14,2,0" TextTrimming="CharacterEllipsis"/>
            <Border x:Name="index" Style="{StaticResource Keycap}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,2,0" Visibility="Collapsed"
                    Background="{DynamicResource Accent}" BorderBrush="{DynamicResource AccentHover}">
                <TextBlock Text="{Binding IndexLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentInk}"/>
            </Border>

            <!-- the rail -->
            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource Rail}" HorizontalAlignment="Center"/>
            <Ellipse x:Name="halo" Grid.Column="1" Width="17" Height="17" Fill="{Binding Hue}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0"
                     Opacity="{Binding (ui:Motion.Open), RelativeSource={RelativeSource Self}, Converter={StaticResource Affine}, ConverterParameter='0 0.22'}"/>
            <Ellipse x:Name="dot" Grid.Column="1" Width="7" Height="7" Fill="{Binding Hue}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,19,0,0"
                     RenderTransformOrigin="0.5,0.5" Opacity="{Binding (ui:Motion.Open), RelativeSource={RelativeSource Self}, Converter={StaticResource Affine}, ConverterParameter='0.7 0.3'}">
                <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="{Binding (ui:Motion.Open), ElementName=dot, Converter={StaticResource Affine}, ConverterParameter='1 0.45'}"
                                    ScaleY="{Binding (ui:Motion.Open), ElementName=dot, Converter={StaticResource Affine}, ConverterParameter='1 0.45'}"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Path x:Name="pin" Data="M2,0 H8 L7,3.5 L9.5,6 H0.5 L3,3.5 Z M5,6 V10.5" Fill="{DynamicResource Accent}" Stroke="{DynamicResource Accent}" StrokeThickness="1.1"
                  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,32,4,0" Visibility="Collapsed" ToolTip="{c:T Pinned}"/>

            <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplateSelector="{StaticResource PanelBodies}" Margin="12,10,12,10"/>

            <StackPanel x:Name="acts" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Opacity="0">
                <Button Style="{StaticResource RowAction}" Command="{x:Static ui:Cmds.TogglePin}" CommandParameter="{Binding}" ToolTip="{c:T Pin}">
                    <Image Source="{StaticResource Obj.Pinned}" Width="15" Height="15"/>
                </Button>
                <Button Style="{StaticResource RowAction}" Command="{x:Static ui:Cmds.Delete}" CommandParameter="{Binding}" ToolTip="{c:T Delete}">
                    <Image Source="{StaticResource Obj.Trash}" Width="15" Height="15"/>
                </Button>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="time" Property="Foreground" Value="{DynamicResource Ink}"/>
            </DataTrigger>
            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetName="acts" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetName="acts" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding Pinned}" Value="True"><Setter TargetName="pin" Property="Visibility" Value="Visible"/></DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ShowIndex}" Value="True"/>
                    <Condition Binding="{Binding IndexLabel, Converter={StaticResource CVis}}" Value="Visible"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="index" Property="Visibility" Value="Visible"/>
                <Setter TargetName="time" Property="Visibility" Value="Hidden"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
