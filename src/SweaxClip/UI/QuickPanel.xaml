<Window x:Class="SweaxClip.UI.QuickPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SweaxClip.Core"
        xmlns:ui="clr-namespace:SweaxClip.UI"
        Title="SweaxClip" Width="384" Height="540"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000" ShowActivated="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ui:RowSelector x:Key="Rows" ClipKey="Row.Panel"/>
    </Window.Resources>

    <Grid x:Name="root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- category tabs, icon only like the Windows emoji / clipboard panel -->
        <ItemsControl x:Name="tabs" ItemsSource="{Binding Scopes}" Margin="8,8,8,0" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type c:ScopeInfo}">
                    <Button x:Name="tab" Style="{StaticResource SubtleButton}" Height="36" Padding="0" Margin="1,0" ToolTip="{Binding Label}" Focusable="False"
                            Command="{x:Static ui:Cmds.SetScope}" CommandParameter="{Binding Scope}">
                        <Grid Width="34" Height="36">
                            <TextBlock x:Name="glyph" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                            <Border x:Name="pill" Width="16" Height="3" CornerRadius="1.5" Background="{DynamicResource AccentFill}" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Hidden"/>
                        </Grid>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Active}" Value="True">
                            <Setter TargetName="tab" Property="Background" Value="{DynamicResource SubtleFillHover}"/>
                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBox x:Name="search" Grid.Row="1" Style="{StaticResource SearchBox}" Tag="{c:T SearchHintShort}" Margin="12,10,12,4"
                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>

        <Grid Grid.Row="2" Margin="16,8,8,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ScopeTitle}" Style="{StaticResource BodyStrong}"/>
                <TextBlock x:Name="count" Style="{StaticResource Caption}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                <Border x:Name="pausedBadge" Background="{DynamicResource ControlFill}" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1" CornerRadius="4"
                        Padding="6,1,6,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="10" Margin="0,1,5,0"/>
                        <TextBlock Text="{c:T Paused}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" HorizontalAlignment="Right" FontSize="14" ToolTip="{c:T OpenLibrary}" Click="OpenLibrary_Click"/>
        </Grid>

        <ListBox x:Name="list" Grid.Row="3" Style="{StaticResource BareList}" ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource Rows}"
                 PreviewMouseLeftButtonUp="List_MouseUp" Padding="0,2,0,10"/>

        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0,40,60"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" IsHitTestVisible="False">
            <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource TextTertiary}"/>
            <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,16,0,4"/>
            <TextBlock Text="{Binding EmptyBody}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <Border x:Name="toast" Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Background="{DynamicResource FlyoutFill}"
                BorderBrush="{DynamicResource FlyoutStroke}" BorderThickness="1" CornerRadius="4" Padding="12,6,12,7" Opacity="0" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.22"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentText}" Margin="0,1,8,0"/>
                <TextBlock x:Name="toastText" Style="{StaticResource Body}" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
