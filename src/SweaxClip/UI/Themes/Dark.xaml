<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- SweaxClip "Deck" tokens (dark desk) -->
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>
    <sys:Double x:Key="ShadowOpacity">0.55</sys:Double>
    <Color x:Key="DeskColor">#FF171615</Color>
    <Color x:Key="DeskEdgeColor">#FF1D1C1A</Color>
    <Color x:Key="SurfaceColor">#FF262422</Color>
    <Color x:Key="Surface2Color">#FF201F1D</Color>
    <Color x:Key="SurfaceHoverColor">#14FFFFFF</Color>
    <Color x:Key="SurfacePressColor">#1FFFFFFF</Color>
    <Color x:Key="LineColor">#14FFFFFF</Color>
    <Color x:Key="Line2Color">#24FFFFFF</Color>
    <Color x:Key="InkColor">#FFF2EFE9</Color>
    <Color x:Key="Ink2Color">#A8F2EFE9</Color>
    <Color x:Key="Ink3Color">#6EF2EFE9</Color>
    <Color x:Key="AccentColor">#FFFF6A3D</Color>
    <Color x:Key="AccentHoverColor">#FFFF8159</Color>
    <Color x:Key="AccentInkColor">#FF1A0E09</Color>
    <Color x:Key="AccentSoftColor">#26FF6A3D</Color>
    <Color x:Key="SmokeColor">#99000000</Color>
    <Color x:Key="ChipFillColor">#F2262422</Color>
    <Color x:Key="PaperColor">#FF2A2826</Color>
    <Color x:Key="PaperInkColor">#FFEDE9E3</Color>
    <Color x:Key="PaperInk2Color">#8CEDE9E3</Color>
    <Color x:Key="PaperLineColor">#16FFFFFF</Color>
    <Color x:Key="ManilaColor">#FF3B3426</Color>
    <Color x:Key="ManilaDeepColor">#FF2F2A1F</Color>
    <Color x:Key="ManilaInkColor">#FFEBDDB8</Color>
    <Color x:Key="ManilaInk2Color">#A6EBDDB8</Color>
    <Color x:Key="SlateColor">#FF1A1D23</Color>
    <Color x:Key="SlateInkColor">#FFE6E8EE</Color>
    <Color x:Key="SlateInk2Color">#99E6E8EE</Color>
    <Color x:Key="SynKeywordColor">#FFFF8A65</Color>
    <Color x:Key="SynStringColor">#FFA5D6A7</Color>
    <Color x:Key="SynCommentColor">#FF7C8594</Color>
    <Color x:Key="SynNumberColor">#FFFFD180</Color>
    <Color x:Key="SynTypeColor">#FF80CBC4</Color>
    <Color x:Key="DangerColor">#FFFF7A5C</Color>
    <Color x:Key="ShadowTintColor">#FF000000</Color>
    <SolidColorBrush x:Key="Desk" Color="#FF171615"/>
    <SolidColorBrush x:Key="DeskEdge" Color="#FF1D1C1A"/>
    <SolidColorBrush x:Key="Surface" Color="#FF262422"/>
    <SolidColorBrush x:Key="Surface2" Color="#FF201F1D"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="SurfacePress" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Line2" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#FFF2EFE9"/>
    <SolidColorBrush x:Key="Ink2" Color="#A8F2EFE9"/>
    <SolidColorBrush x:Key="Ink3" Color="#6EF2EFE9"/>
    <SolidColorBrush x:Key="Accent" Color="#FFFF6A3D"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FFFF8159"/>
    <SolidColorBrush x:Key="AccentInk" Color="#FF1A0E09"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#26FF6A3D"/>
    <SolidColorBrush x:Key="Smoke" Color="#99000000"/>
    <SolidColorBrush x:Key="ChipFill" Color="#F2262422"/>
    <SolidColorBrush x:Key="Paper" Color="#FF2A2826"/>
    <SolidColorBrush x:Key="PaperInk" Color="#FFEDE9E3"/>
    <SolidColorBrush x:Key="PaperInk2" Color="#8CEDE9E3"/>
    <SolidColorBrush x:Key="PaperLine" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="Manila" Color="#FF3B3426"/>
    <SolidColorBrush x:Key="ManilaDeep" Color="#FF2F2A1F"/>
    <SolidColorBrush x:Key="ManilaInk" Color="#FFEBDDB8"/>
    <SolidColorBrush x:Key="ManilaInk2" Color="#A6EBDDB8"/>
    <SolidColorBrush x:Key="Slate" Color="#FF1A1D23"/>
    <SolidColorBrush x:Key="SlateInk" Color="#FFE6E8EE"/>
    <SolidColorBrush x:Key="SlateInk2" Color="#99E6E8EE"/>
    <SolidColorBrush x:Key="SynKeyword" Color="#FFFF8A65"/>
    <SolidColorBrush x:Key="SynString" Color="#FFA5D6A7"/>
    <SolidColorBrush x:Key="SynComment" Color="#FF7C8594"/>
    <SolidColorBrush x:Key="SynNumber" Color="#FFFFD180"/>
    <SolidColorBrush x:Key="SynType" Color="#FF80CBC4"/>
    <SolidColorBrush x:Key="Danger" Color="#FFFF7A5C"/>
    <SolidColorBrush x:Key="ShadowTint" Color="#FF000000"/>

    <!-- quick panel: surface, rail and one hue per kind of clip -->
    <SolidColorBrush x:Key="PanelEdge" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="PanelGlint" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="RowHover" Color="#0CFFFFFF"/>
    <SolidColorBrush x:Key="Rail" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="Field" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="Hue.Text" Color="#FFD8D3CB"/>
    <SolidColorBrush x:Key="Hue.Link" Color="#FF7DA8FF"/>
    <SolidColorBrush x:Key="Hue.Code" Color="#FF5CD6B4"/>
    <SolidColorBrush x:Key="Hue.Image" Color="#FFF48FB1"/>
    <SolidColorBrush x:Key="Hue.Screenshot" Color="#FFA78BFA"/>
    <SolidColorBrush x:Key="Hue.Files" Color="#FFD7B46A"/>
    <SolidColorBrush x:Key="Hue.All" Color="#FFFF6A3D"/>
    <SolidColorBrush x:Key="Hue.Pinned" Color="#FFFF6A3D"/>
    <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1F1E1C" Offset="0"/><GradientStop Color="#FF171615" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Hue.Color" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF6A3D" Offset="0"/><GradientStop Color="#FFF2B84B" Offset="0.35"/><GradientStop Color="#FF5CD6B4" Offset="0.7"/><GradientStop Color="#FF7DA8FF" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
