<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- SweaxClip "Deck" tokens (light desk) -->
    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>
    <sys:Double x:Key="ShadowOpacity">0.22</sys:Double>
    <Color x:Key="DeskColor">#FFEEEBE5</Color>
    <Color x:Key="DeskEdgeColor">#FFE6E2DA</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="Surface2Color">#FFF8F6F2</Color>
    <Color x:Key="SurfaceHoverColor">#0F23201D</Color>
    <Color x:Key="SurfacePressColor">#1A23201D</Color>
    <Color x:Key="LineColor">#1423201D</Color>
    <Color x:Key="Line2Color">#2423201D</Color>
    <Color x:Key="InkColor">#FF23201D</Color>
    <Color x:Key="Ink2Color">#A323201D</Color>
    <Color x:Key="Ink3Color">#6E23201D</Color>
    <Color x:Key="AccentColor">#FFE4572E</Color>
    <Color x:Key="AccentHoverColor">#FFEF6A42</Color>
    <Color x:Key="AccentInkColor">#FFFFFFFF</Color>
    <Color x:Key="AccentSoftColor">#1FE4572E</Color>
    <Color x:Key="SmokeColor">#5923201D</Color>
    <Color x:Key="ChipFillColor">#F2FFFFFF</Color>
    <Color x:Key="PaperColor">#FFFFFDF8</Color>
    <Color x:Key="PaperInkColor">#FF23201D</Color>
    <Color x:Key="PaperInk2Color">#9E23201D</Color>
    <Color x:Key="PaperLineColor">#1423201D</Color>
    <Color x:Key="ManilaColor">#FFEAD7A8</Color>
    <Color x:Key="ManilaDeepColor">#FFDCC48E</Color>
    <Color x:Key="ManilaInkColor">#FF4A3B1F</Color>
    <Color x:Key="ManilaInk2Color">#A64A3B1F</Color>
    <Color x:Key="SlateColor">#FF1D2027</Color>
    <Color x:Key="SlateInkColor">#FFE6E8EE</Color>
    <Color x:Key="SlateInk2Color">#99E6E8EE</Color>
    <Color x:Key="SynKeywordColor">#FFFF8A65</Color>
    <Color x:Key="SynStringColor">#FFA5D6A7</Color>
    <Color x:Key="SynCommentColor">#FF7C8594</Color>
    <Color x:Key="SynNumberColor">#FFFFD180</Color>
    <Color x:Key="SynTypeColor">#FF80CBC4</Color>
    <Color x:Key="DangerColor">#FFC8402A</Color>
    <Color x:Key="ShadowTintColor">#FF3A2A1A</Color>
    <SolidColorBrush x:Key="Desk" Color="#FFEEEBE5"/>
    <SolidColorBrush x:Key="DeskEdge" Color="#FFE6E2DA"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#FFF8F6F2"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#0F23201D"/>
    <SolidColorBrush x:Key="SurfacePress" Color="#1A23201D"/>
    <SolidColorBrush x:Key="Line" Color="#1423201D"/>
    <SolidColorBrush x:Key="Line2" Color="#2423201D"/>
    <SolidColorBrush x:Key="Ink" Color="#FF23201D"/>
    <SolidColorBrush x:Key="Ink2" Color="#A323201D"/>
    <SolidColorBrush x:Key="Ink3" Color="#6E23201D"/>
    <SolidColorBrush x:Key="Accent" Color="#FFE4572E"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FFEF6A42"/>
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1FE4572E"/>
    <SolidColorBrush x:Key="Smoke" Color="#5923201D"/>
    <SolidColorBrush x:Key="ChipFill" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="Paper" Color="#FFFFFDF8"/>
    <SolidColorBrush x:Key="PaperInk" Color="#FF23201D"/>
    <SolidColorBrush x:Key="PaperInk2" Color="#9E23201D"/>
    <SolidColorBrush x:Key="PaperLine" Color="#1423201D"/>
    <SolidColorBrush x:Key="Manila" Color="#FFEAD7A8"/>
    <SolidColorBrush x:Key="ManilaDeep" Color="#FFDCC48E"/>
    <SolidColorBrush x:Key="ManilaInk" Color="#FF4A3B1F"/>
    <SolidColorBrush x:Key="ManilaInk2" Color="#A64A3B1F"/>
    <SolidColorBrush x:Key="Slate" Color="#FF1D2027"/>
    <SolidColorBrush x:Key="SlateInk" Color="#FFE6E8EE"/>
    <SolidColorBrush x:Key="SlateInk2" Color="#99E6E8EE"/>
    <SolidColorBrush x:Key="SynKeyword" Color="#FFFF8A65"/>
    <SolidColorBrush x:Key="SynString" Color="#FFA5D6A7"/>
    <SolidColorBrush x:Key="SynComment" Color="#FF7C8594"/>
    <SolidColorBrush x:Key="SynNumber" Color="#FFFFD180"/>
    <SolidColorBrush x:Key="SynType" Color="#FF80CBC4"/>
    <SolidColorBrush x:Key="Danger" Color="#FFC8402A"/>
    <SolidColorBrush x:Key="ShadowTint" Color="#FF3A2A1A"/>

    <!-- quick panel: surface, rail and one hue per kind of clip -->
    <SolidColorBrush x:Key="PanelEdge" Color="#2123201D"/>
    <SolidColorBrush x:Key="PanelGlint" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="RowHover" Color="#0923201D"/>
    <SolidColorBrush x:Key="Rail" Color="#1C23201D"/>
    <SolidColorBrush x:Key="Field" Color="#0723201D"/>
    <SolidColorBrush x:Key="Hue.Text" Color="#FF6E675F"/>
    <SolidColorBrush x:Key="Hue.Link" Color="#FF2F6BEA"/>
    <SolidColorBrush x:Key="Hue.Code" Color="#FF0E8F70"/>
    <SolidColorBrush x:Key="Hue.Image" Color="#FFC2416D"/>
    <SolidColorBrush x:Key="Hue.Screenshot" Color="#FF6D4FD8"/>
    <SolidColorBrush x:Key="Hue.Files" Color="#FF96701E"/>
    <SolidColorBrush x:Key="Hue.All" Color="#FFE4572E"/>
    <SolidColorBrush x:Key="Hue.Pinned" Color="#FFE4572E"/>
    <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#FFF7F5F1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Hue.Color" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE4572E" Offset="0"/><GradientStop Color="#FFD99A1E" Offset="0.35"/><GradientStop Color="#FF0E8F70" Offset="0.7"/><GradientStop Color="#FF2F6BEA" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
