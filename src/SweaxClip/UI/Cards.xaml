<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SweaxClip.Core"
                    xmlns:ui="clr-namespace:SweaxClip.UI">

    <!-- Every clip is an object made of its own material. Cards are 392×232; the library scales them. -->

    <ui:CardSelector x:Key="Cards"/>
    <ui:BoolToVis x:Key="CVis"/>

    <!-- absolute, so short text is never faded: only what runs into the card's bottom edge -->
    <LinearGradientBrush x:Key="FadeMask" StartPoint="0,0" EndPoint="0,168" MappingMode="Absolute">
        <GradientStop Color="Black" Offset="0"/><GradientStop Color="Black" Offset="0.74"/><GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TopScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#99000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- the source app's icon, or its initial on a stamp when the app has none -->
    <DataTemplate x:Key="AppGlyph" DataType="{x:Type c:ClipItem}">
        <Grid>
            <Image Source="{Binding AppIcon}" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border x:Name="initial" CornerRadius="5" Background="#E4572E" Visibility="Collapsed">
                <Viewbox Margin="3"><TextBlock Text="{Binding AppInitial}" FontWeight="Bold" Foreground="White"/></Viewbox>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding AppIcon}" Value="{x:Null}"><Setter TargetName="initial" Property="Visibility" Value="Visible"/></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- header shared by every card: app, time, pin, the kind's object -->
    <DataTemplate x:Key="CardHeader" DataType="{x:Type c:ClipItem}">
        <Grid Height="40" Margin="16,0,12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,9,0">
                <Image x:Name="app" Source="{Binding AppIcon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border x:Name="initial" CornerRadius="5" Background="#E4572E" Visibility="Collapsed">
                    <TextBlock Text="{Binding AppInitial}" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                </Border>
                <Border x:Name="badge" CornerRadius="5" Background="#E4572E" Visibility="Collapsed" Margin="-2">
                    <TextBlock Text="{Binding IndexLabel}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                <Run Text="{Binding AppName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding RelTime, Mode=OneWay}"/>
            </TextBlock>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding UsesLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Visibility="{Binding UsesLabel, Converter={StaticResource CVis}}"/>
                <Image x:Name="pin" Source="{StaticResource Obj.Pinned}" Width="16" Height="16" Margin="0,0,6,0" Visibility="Collapsed"/>
                <Image Source="{Binding KindIcon}" Width="18" Height="18"/>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Pinned}" Value="True"><Setter TargetName="pin" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding AppIcon}" Value="{x:Null}"><Setter TargetName="initial" Property="Visibility" Value="Visible"/></DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ShowIndex}" Value="True"/>
                    <Condition Binding="{Binding IndexLabel, Converter={StaticResource CVis}}" Value="Visible"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- paper: plain and rich text -->
    <DataTemplate x:Key="Card.Text" DataType="{x:Type c:ClipItem}">
        <Border Width="392" Height="232" CornerRadius="14" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource PaperLine}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" Tag="{DynamicResource PaperInk2}"/>
                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource PaperLine}" Margin="16,0"/>
                <TextBlock Grid.Row="1" Text="{Binding Preview}" Margin="18,12,18,16" FontSize="15.5" LineHeight="23" LineStackingStrategy="BlockLineHeight"
                           TextWrapping="Wrap" Foreground="{DynamicResource PaperInk}" OpacityMask="{StaticResource FadeMask}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- paper with the site's colour band -->
    <DataTemplate x:Key="Card.Link" DataType="{x:Type c:ClipItem}">
        <Border Width="392" Height="232" CornerRadius="14" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource PaperLine}" BorderThickness="1">
            <Grid ui:Round.Radius="13">
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Width="7" HorizontalAlignment="Left" Background="{Binding SiteBrush}"/>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" Tag="{DynamicResource PaperInk2}" Margin="4,0,0,0"/>
                <Grid Grid.Row="1" Margin="24,10,20,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="{Binding SiteBrush}">
                            <TextBlock Text="{Binding SiteInitial}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        </Border>
                        <TextBlock Text="{Binding LinkHost}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource PaperInk}" VerticalAlignment="Center" Margin="14,0,0,2"
                                   TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding LinkRest}" FontSize="13" Foreground="{DynamicResource PaperInk2}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Margin="0,12,0,0" MaxHeight="38" FontFamily="{StaticResource MonoFont}"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Foreground="{Binding SiteBrush}" Margin="0,1,7,0"/>
                        <TextBlock Text="{c:T OpenLink}" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding SiteBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- slate: code with line numbers and colour -->
    <DataTemplate x:Key="Card.Code" DataType="{x:Type c:ClipItem}">
        <Border Width="392" Height="232" CornerRadius="14" Background="{DynamicResource Slate}" BorderBrush="#26FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" Tag="{DynamicResource SlateInk2}"/>
                <Grid Grid.Row="1" Margin="14,4,16,14" OpacityMask="{StaticResource FadeMask}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LineNumbers}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                               Foreground="#4DE6E8EE" TextAlignment="Right" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="1" ui:CodeView.Source="{Binding CodeSnippet}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" LineHeight="19"
                               LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" Typography.StandardLigatures="False"/>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- the colour itself -->
    <DataTemplate x:Key="Card.Color" DataType="{x:Type c:ClipItem}">
        <Border Width="392" Height="232" CornerRadius="14" Background="{Binding Swatch}" BorderBrush="#1F000000" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" Tag="{Binding SwatchInk}"/>
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="20,0,20,18">
                    <TextBlock Text="{Binding ColorHex}" FontFamily="{StaticResource MonoFont}" FontSize="34" FontWeight="SemiBold" Foreground="{Binding SwatchInk}"/>
                    <TextBlock Text="{Binding ColorDetail}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{Binding SwatchInk}" Opacity="0.8" Margin="2,6,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- a print: image to the edges, header over a scrim -->
    <DataTemplate x:Key="Card.Image" DataType="{x:Type c:ClipItem}">
        <Border Width="392" Height="232" CornerRadius="14" Background="#2B2A28" BorderBrush="#1F000000" BorderThickness="1">
            <Grid ui:Round.Radius="13">
                <Image ui:ThumbLoader.Width="400" Stretch="UniformToFill" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Height="64" VerticalAlignment="Top" Background="{StaticResource TopScrim}"/>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" Tag="#F2FFFFFF" VerticalAlignment="Top"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" CornerRadius="7" Background="#99000000" Padding="8,3,8,4">
                    <TextBlock FontSize="11.5" Foreground="White"><Run Text="{Binding Dimensions, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SizeText, Mode=OneWay}"/></TextBlock>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- a screen: the shot sits inside a slate bezel with crop marks -->
    <DataTemplate x:Key="Card.Screenshot" DataType="{x:Type c:ClipItem}">
        <Border Width="392" Height="232" CornerRadius="14" Background="{DynamicResource Slate}" BorderBrush="#26FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" Tag="{DynamicResource SlateInk2}"/>
                <Grid Grid.Row="1" Margin="12,0,12,12" ui:Round.Radius="7">
                    <Border Background="#0FFFFFFF"/>
                    <Image ui:ThumbLoader.Width="380" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" CornerRadius="6" Background="#B31D2027" Padding="7,2,7,3">
                        <TextBlock Text="{Binding Dimensions}" FontSize="11" Foreground="#E6E8EE"/>
                    </Border>
                </Grid>
                <Path Grid.Row="1" Stroke="#E4572E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="6,-6,6,6" Stretch="Fill"
                      Data="M0,14 V0 H14 M352,0 H366 V14 M366,162 V176 H352 M14,176 H0 V162" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- a manila folder with a tab -->
    <DataTemplate x:Key="Card.Files" DataType="{x:Type c:ClipItem}">
        <Grid Width="392" Height="232">
            <Path Fill="{DynamicResource ManilaDeep}" Data="M0,22 A10,10 0 0 1 10,12 H128 A10,10 0 0 1 136,16 L146,30 H382 A10,10 0 0 1 392,40 V60 H0 Z"/>
            <Border Margin="0,26,0,0" CornerRadius="14" Background="{DynamicResource Manila}" BorderBrush="#1A4A3B1F" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" Tag="{DynamicResource ManilaInk2}"/>
                    <Grid Grid.Row="1" Margin="18,6,18,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="12" Background="#66FFFFFF" VerticalAlignment="Top">
                            <Image Source="{Binding FileIcon}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,4,0,0">
                            <TextBlock Text="{Binding Preview}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ManilaInk}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource ManilaInk2}" Margin="0,8,0,0">
                                <Run Text="{Binding Stats, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- a folder holding one picture -->
    <DataTemplate x:Key="Card.FilesVisual" DataType="{x:Type c:ClipItem}">
        <Grid Width="392" Height="232">
            <Path Fill="{DynamicResource ManilaDeep}" Data="M0,22 A10,10 0 0 1 10,12 H128 A10,10 0 0 1 136,16 L146,30 H382 A10,10 0 0 1 392,40 V60 H0 Z"/>
            <Border Margin="0,26,0,0" CornerRadius="14" Background="{DynamicResource Manila}" BorderBrush="#1A4A3B1F" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" Tag="{DynamicResource ManilaInk2}"/>
                    <Grid Grid.Row="1" Margin="14,0,14,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="6" Padding="5" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><RotateTransform Angle="-3"/></Border.RenderTransform>
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.25"/></Border.Effect>
                            <Grid ui:Round.Radius="3"><Image ui:ThumbLoader.Width="200" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,6,0,0">
                            <TextBlock Text="{Binding Preview}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ManilaInk}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource ManilaInk2}" Margin="0,8,0,0">
                                <Run Text="{Binding Dimensions, Mode=OneWay}"/><LineBreak/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
