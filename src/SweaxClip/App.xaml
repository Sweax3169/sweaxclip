<Application x:Class="SweaxClip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Themes/Light.xaml"/>
                <ResourceDictionary Source="UI/Controls.xaml"/>
                <ResourceDictionary Source="UI/Objects.xaml"/>
                <ResourceDictionary Source="UI/Cards.xaml"/>
                <ResourceDictionary Source="UI/Templates.xaml"/>
                <ResourceDictionary Source="UI/PanelRows.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
