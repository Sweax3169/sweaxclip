<UserControl x:Class="SweaxClip.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SweaxClip.Core">
    <UserControl.Resources>
        <!-- each group is an index divider: a manila tab sticking out of a sheet -->
        <Style x:Key="Folder" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <Border Background="{DynamicResource Manila}" CornerRadius="10,16,0,0" HorizontalAlignment="Left" Padding="18,7,26,6">
                                <ContentPresenter ContentSource="Header" TextElement.Foreground="{DynamicResource ManilaInk}" TextElement.FontSize="13" TextElement.FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Manila}" BorderThickness="0,3,0,0"
                                    CornerRadius="0,14,14,14" Padding="24,4,22,4" Effect="{StaticResource LiftShadow}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="Padding" Value="0,12"/>
        </Style>
        <Style x:Key="RowText" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,28,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="Inline" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="13,6,13,7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- a choice drawn as its own picture: panel styles and palettes -->
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="13" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1.5" Padding="8"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="press"/></Border.RenderTransform>
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="tick" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-6,0" Visibility="Collapsed">
                                <Path Data="M5,10 L8.5,13.5 L15,6.5" Stroke="{DynamicResource AccentInk}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,30,40,40" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="{c:T Settings}" Style="{StaticResource Title}" FontSize="28" Margin="0,0,0,24"/>

            <HeaderedContentControl Header="{c:T SetAppearance}" Style="{StaticResource Folder}">
                <StackPanel>
                    <!-- panel style -->
                    <Border Style="{StaticResource Row}" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="{c:T SetPanelStyle}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{c:T SetPanelStyleNote}" Style="{StaticResource Note}"/>
                            <WrapPanel Margin="0,16,0,0">
                                <RadioButton x:Name="styleTimeline" GroupName="style" Style="{StaticResource Choice}" Tag="timeline" Click="Style_Click">
                                    <StackPanel Width="236">
                                        <Border Height="132" CornerRadius="9" Background="{DynamicResource Desk}" ClipToBounds="True">
                                            <Canvas>
                                                <Border Canvas.Left="34" Canvas.Top="14" Width="168" Height="128" CornerRadius="9" Background="{DynamicResource PanelFill}" BorderBrush="{DynamicResource PanelEdge}" BorderThickness="1"/>
                                                <Rectangle Canvas.Left="46" Canvas.Top="25" Width="62" Height="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource Line2}"/>
                                                <Rectangle Canvas.Left="62" Canvas.Top="42" Width="1" Height="100" Fill="{DynamicResource Rail}"/>
                                                <Border Canvas.Left="70" Canvas.Top="40" Width="122" Height="34" CornerRadius="6" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"/>
                                                <Ellipse Canvas.Left="59" Canvas.Top="46" Width="7" Height="7" Fill="{DynamicResource Accent}"/>
                                                <Rectangle Canvas.Left="78" Canvas.Top="47" Width="96" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Ink2}"/>
                                                <Rectangle Canvas.Left="78" Canvas.Top="58" Width="70" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Ink3}"/>
                                                <Ellipse Canvas.Left="60" Canvas.Top="84" Width="5" Height="5" Fill="{DynamicResource Hue.Link}"/>
                                                <Rectangle Canvas.Left="78" Canvas.Top="84" Width="84" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Ink3}"/>
                                                <Ellipse Canvas.Left="60" Canvas.Top="102" Width="5" Height="5" Fill="{DynamicResource Hue.Screenshot}"/>
                                                <Border Canvas.Left="78" Canvas.Top="98" Width="100" Height="14" CornerRadius="3" Background="{DynamicResource Slate}"/>
                                                <Ellipse Canvas.Left="60" Canvas.Top="124" Width="5" Height="5" Fill="{DynamicResource Hue.Code}"/>
                                                <Rectangle Canvas.Left="78" Canvas.Top="124" Width="64" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Ink3}"/>
                                            </Canvas>
                                        </Border>
                                        <TextBlock Text="{c:T StyleTimeline}" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="2,10,0,0"/>
                                        <TextBlock Text="{c:T StyleTimelineNote}" Style="{StaticResource Note}" Margin="2,2,0,2"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="styleDeck" GroupName="style" Style="{StaticResource Choice}" Tag="deck" Click="Style_Click">
                                    <StackPanel Width="236">
                                        <Border Height="132" CornerRadius="9" Background="{DynamicResource Desk}" ClipToBounds="True">
                                            <Canvas>
                                                <Border Canvas.Left="62" Canvas.Top="16" Width="112" Height="60" CornerRadius="7" Background="{DynamicResource Manila}" BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
                                                <Border Canvas.Left="52" Canvas.Top="36" Width="132" Height="66" CornerRadius="8" Background="{DynamicResource Slate}"/>
                                                <Rectangle Canvas.Left="64" Canvas.Top="44" Width="44" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#55FFFFFF"/>
                                                <Border Canvas.Left="40" Canvas.Top="58" Width="156" Height="80" CornerRadius="9" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource PaperLine}" BorderThickness="1">
                                                    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.25"/></Border.Effect>
                                                </Border>
                                                <Ellipse Canvas.Left="52" Canvas.Top="68" Width="8" Height="8" Fill="{DynamicResource Accent}"/>
                                                <Rectangle Canvas.Left="66" Canvas.Top="70" Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource PaperInk2}"/>
                                                <Rectangle Canvas.Left="52" Canvas.Top="88" Width="120" Height="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource PaperInk}"/>
                                                <Rectangle Canvas.Left="52" Canvas.Top="100" Width="84" Height="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource PaperInk}"/>
                                            </Canvas>
                                        </Border>
                                        <TextBlock Text="{c:T StyleDeck}" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="2,10,0,0"/>
                                        <TextBlock Text="{c:T StyleDeckNote}" Style="{StaticResource Note}" Margin="2,2,0,2"/>
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- theme -->
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetTheme}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetThemeNote}" Style="{StaticResource Note}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource Field}" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="themeSystem" GroupName="theme" Style="{StaticResource Segment}" Tag="system" Content="{c:T ThemeSystem}" Click="Theme_Click"/>
                                    <RadioButton x:Name="themeLight" GroupName="theme" Style="{StaticResource Segment}" Tag="light" Content="{c:T ThemeLight}" Click="Theme_Click"/>
                                    <RadioButton x:Name="themeDark" GroupName="theme" Style="{StaticResource Segment}" Tag="dark" Content="{c:T ThemeDark}" Click="Theme_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- palette -->
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="{c:T SetPalette}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{c:T SetPaletteNote}" Style="{StaticResource Note}"/>
                            <ItemsControl x:Name="palettes" Margin="0,16,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="palette" Style="{StaticResource Choice}" Tag="{Binding Key}" IsChecked="{Binding Selected, Mode=OneWay}" Click="Palette_Click">
                                            <StackPanel Width="84">
                                                <Border Height="62" CornerRadius="8" Background="{Binding Desk}" BorderBrush="{Binding Edge}" BorderThickness="1" ClipToBounds="True">
                                                    <Canvas>
                                                        <Border Canvas.Left="8" Canvas.Top="9" Width="48" Height="44" CornerRadius="5" Background="{Binding Surface}" BorderBrush="{Binding Edge}" BorderThickness="1"/>
                                                        <Ellipse Canvas.Left="14" Canvas.Top="16" Width="8" Height="8" Fill="{Binding Accent}"/>
                                                        <Rectangle Canvas.Left="14" Canvas.Top="30" Width="34" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding Edge}"/>
                                                        <Rectangle Canvas.Left="14" Canvas.Top="39" Width="22" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding Edge}"/>
                                                        <Border Canvas.Left="60" Canvas.Top="9" Width="16" Height="20" CornerRadius="4" Background="{Binding Paper}" BorderBrush="{Binding Edge}" BorderThickness="1"/>
                                                        <Border Canvas.Left="60" Canvas.Top="33" Width="16" Height="20" CornerRadius="4" Background="{Binding Slate}"/>
                                                    </Canvas>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="2,8,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="{c:T SetGeneral}" Style="{StaticResource Folder}">
                <StackPanel>
                    <Border Style="{StaticResource Row}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetHotkey}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetHotkeyNote}" Style="{StaticResource Note}"/>
                            </StackPanel>
                            <ComboBox x:Name="hotkeyBox" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="Hotkey_Changed">
                                <ComboBoxItem Content="Win + V" Tag="Win+V"/>
                                <ComboBoxItem Content="Ctrl + Shift + V" Tag="Ctrl+Shift+V"/>
                                <ComboBoxItem Content="Ctrl + Alt + V" Tag="Ctrl+Alt+V"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetGrab}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetGrabNote}" Style="{StaticResource Note}"/>
                                <TextBlock x:Name="grabStatus" Style="{StaticResource Note}" Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                            </StackPanel>
                            <Button x:Name="grabKey" Grid.Column="1" Style="{StaticResource Inline}" MinWidth="168" Margin="0,0,18,0" Click="GrabKey_Click"
                                    FontFamily="{StaticResource UiFont}"/>
                            <CheckBox x:Name="grab" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetStartup}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetStartupNote}" Style="{StaticResource Note}"/>
                            </StackPanel>
                            <CheckBox x:Name="startup" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetPastePlain}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetPastePlainNote}" Style="{StaticResource Note}"/>
                            </StackPanel>
                            <CheckBox x:Name="plain" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetMoveToTop}" Style="{StaticResource Label}"/>
                            </StackPanel>
                            <CheckBox x:Name="toTop" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetLanguage}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetLanguageNote}" Style="{StaticResource Note}"/>
                            </StackPanel>
                            <ComboBox x:Name="langBox" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="Lang_Changed">
                                <ComboBoxItem Content="{c:T SetLanguageAuto}" Tag="auto"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="Türkçe" Tag="tr"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="{c:T SetCapture}" Style="{StaticResource Folder}">
                <StackPanel>
                    <Border Style="{StaticResource Row}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}"><TextBlock Text="{c:T SetCaptureText}" Style="{StaticResource Label}"/></StackPanel>
                            <CheckBox x:Name="capText" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}"><TextBlock Text="{c:T SetCaptureImages}" Style="{StaticResource Label}"/></StackPanel>
                            <CheckBox x:Name="capImages" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}"><TextBlock Text="{c:T SetCaptureFiles}" Style="{StaticResource Label}"/></StackPanel>
                            <CheckBox x:Name="capFiles" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetWatchShots}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetWatchShotsNote}" Style="{StaticResource Note}"/>
                                <TextBlock x:Name="importStatus" Style="{StaticResource Note}" Foreground="{DynamicResource Accent}"/>
                            </StackPanel>
                            <Button x:Name="importBtn" Grid.Column="1" Style="{StaticResource Inline}" Content="{c:T SetImportShots}" Margin="0,0,18,0" Click="Import_Click"/>
                            <CheckBox x:Name="watch" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetOcr}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetOcrNote}" Style="{StaticResource Note}"/>
                            </StackPanel>
                            <CheckBox x:Name="ocr" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetPrivacy}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetPrivacyNote}" Style="{StaticResource Note}"/>
                            </StackPanel>
                            <CheckBox x:Name="privacy" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}" VerticalAlignment="Top">
                                <TextBlock Text="{c:T SetIgnoredApps}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetIgnoredAppsNote}" Style="{StaticResource Note}"/>
                            </StackPanel>
                            <TextBox x:Name="ignored" Grid.Column="1" Style="{StaticResource FieldBox}" AcceptsReturn="True" Width="260" Height="104" FontSize="13"
                                     FontFamily="{StaticResource MonoFont}" VerticalScrollBarVisibility="Auto" LostKeyboardFocus="Ignored_LostFocus"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="{c:T SetStorage}" Style="{StaticResource Folder}">
                <StackPanel>
                    <Border Style="{StaticResource Row}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetDataFolder}" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="dataPath" Style="{StaticResource Note}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="dataStats" Style="{StaticResource Note}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Inline}" Content="{c:T SetOpenFolder}" Click="OpenFolder_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetBackups}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetRetention}" Style="{StaticResource Note}"/>
                                <TextBlock x:Name="backupStatus" Style="{StaticResource Note}" Foreground="{DynamicResource Accent}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Inline}" Content="{c:T SetBackupNow}" Margin="0,0,18,0" Click="BackupNow_Click"/>
                            <CheckBox x:Name="backups" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Text="{c:T SetExport}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{c:T SetExportNote}" Style="{StaticResource Note}"/>
                            </StackPanel>
                            <Button x:Name="exportBtn" Grid.Column="1" Style="{StaticResource Inline}" Content="{c:T SetExportButton}" Click="Export_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="{c:T SetAbout}" Style="{StaticResource Folder}">
                <Border Style="{StaticResource Row}" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Image Source="{StaticResource AppMark}" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Style="{StaticResource RowText}">
                            <TextBlock Text="SweaxClip" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Note}">
                                <Run x:Name="version"/><Run Text=" · © 2026 Sweax Studios · MIT"/>
                            </TextBlock>
                            <TextBlock x:Name="memory" Style="{StaticResource Note}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Inline}" Click="Source_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{c:T SetSource}"/>
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="11" Margin="8,2,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </HeaderedContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
