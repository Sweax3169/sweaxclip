<UserControl x:Class="SweaxClip.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SweaxClip.Core">
    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12,16,12"/>
            <Setter Property="MinHeight" Value="68"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CardIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CardText" TargetType="StackPanel">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
        </Style>
        <Style x:Key="CardDesc" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrong}">
            <Setter Property="Margin" Value="2,26,0,8"/>
        </Style>
        <Style x:Key="CardGrid" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="36,26,36,40" MaxWidth="1000">
            <TextBlock Text="{c:T Settings}" Style="{StaticResource Title}" Margin="0,0,0,4"/>

            <!-- General -->
            <TextBlock Text="{c:T SetGeneral}" Style="{StaticResource GroupHeader}"/>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE765;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="{c:T SetHotkey}" Style="{StaticResource Body}"/>
                        <TextBlock Text="{c:T SetHotkeyNote}" Style="{StaticResource CardDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="hotkeyBox" Grid.Column="2" Width="200" SelectionChanged="Hotkey_Changed">
                        <ComboBoxItem Content="Win + V" Tag="Win+V"/>
                        <ComboBoxItem Content="Ctrl + Shift + V" Tag="Ctrl+Shift+V"/>
                        <ComboBoxItem Content="Ctrl + Alt + V" Tag="Ctrl+Alt+V"/>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="{c:T SetStartup}" Style="{StaticResource Body}"/>
                        <TextBlock Text="{c:T SetStartupNote}" Style="{StaticResource CardDesc}"/>
                    </StackPanel>
                    <CheckBox x:Name="startup" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8D2;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="{c:T SetPastePlain}" Style="{StaticResource Body}"/>
                        <TextBlock Text="{c:T SetPastePlainNote}" Style="{StaticResource CardDesc}"/>
                    </StackPanel>
                    <CheckBox x:Name="plain" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE74A;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="{c:T SetMoveToTop}" Style="{StaticResource Body}"/>
                    </StackPanel>
                    <CheckBox x:Name="toTop" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xF2B7;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="{c:T SetLanguage}" Style="{StaticResource Body}"/>
                        <TextBlock Text="{c:T SetLanguageNote}" Style="{StaticResource CardDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="langBox" Grid.Column="2" Width="200" SelectionChanged="Lang_Changed">
                        <ComboBoxItem Content="{c:T SetLanguageAuto}" Tag="auto"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Türkçe" Tag="tr"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Capture -->
            <TextBlock Text="{c:T SetCapture}" Style="{StaticResource GroupHeader}"/>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8D2;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}"><TextBlock Text="{c:T SetCaptureText}" Style="{StaticResource Body}"/></StackPanel>
                    <CheckBox x:Name="capText" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEB9F;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}"><TextBlock Text="{c:T SetCaptureImages}" Style="{StaticResource Body}"/></StackPanel>
                    <CheckBox x:Name="capImages" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}"><TextBlock Text="{c:T SetCaptureFiles}" Style="{StaticResource Body}"/></StackPanel>
                    <CheckBox x:Name="capFiles" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xF7ED;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="{c:T SetWatchShots}" Style="{StaticResource Body}"/>
                        <TextBlock Text="{c:T SetWatchShotsNote}" Style="{StaticResource CardDesc}"/>
                        <TextBlock x:Name="importStatus" Style="{StaticResource CardDesc}" Foreground="{DynamicResource AccentText}"/>
                    </StackPanel>
                    <Button x:Name="importBtn" Grid.Column="2" Style="{StaticResource StandardButton}" Content="{c:T SetImportShots}" Margin="0,0,20,0" Click="Import_Click"/>
                    <CheckBox x:Name="watch" Grid.Column="3" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8E9;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="{c:T SetOcr}" Style="{StaticResource Body}"/>
                        <TextBlock Text="{c:T SetOcrNote}" Style="{StaticResource CardDesc}"/>
                    </StackPanel>
                    <CheckBox x:Name="ocr" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="{c:T SetPrivacy}" Style="{StaticResource Body}"/>
                        <TextBlock Text="{c:T SetPrivacyNote}" Style="{StaticResource CardDesc}"/>
                    </StackPanel>
                    <CheckBox x:Name="privacy" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE71A;" Style="{StaticResource CardIcon}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Style="{StaticResource CardText}" VerticalAlignment="Top">
                        <TextBlock Text="{c:T SetIgnoredApps}" Style="{StaticResource Body}"/>
                        <TextBlock Text="{c:T SetIgnoredAppsNote}" Style="{StaticResource CardDesc}"/>
                    </StackPanel>
                    <TextBox x:Name="ignored" Grid.Column="2" Style="{StaticResource FieldBox}" AcceptsReturn="True" Width="260" Height="104" FontSize="13"
                             VerticalScrollBarVisibility="Auto" LostKeyboardFocus="Ignored_LostFocus"/>
                </Grid>
            </Border>

            <!-- Storage -->
            <TextBlock Text="{c:T SetStorage}" Style="{StaticResource GroupHeader}"/>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="{c:T SetDataFolder}" Style="{StaticResource Body}"/>
                        <TextBlock x:Name="dataPath" Style="{StaticResource CardDesc}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="dataStats" Style="{StaticResource CardDesc}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource StandardButton}" Content="{c:T SetOpenFolder}" Click="OpenFolder_Click"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA35;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="{c:T SetBackups}" Style="{StaticResource Body}"/>
                        <TextBlock Text="{c:T SetRetention}" Style="{StaticResource CardDesc}"/>
                        <TextBlock x:Name="backupStatus" Style="{StaticResource CardDesc}" Foreground="{DynamicResource AccentText}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource StandardButton}" Content="{c:T SetBackupNow}" Margin="0,0,20,0" Click="BackupNow_Click"/>
                    <CheckBox x:Name="backups" Grid.Column="3" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEDE1;" Style="{StaticResource CardIcon}"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="{c:T SetExport}" Style="{StaticResource Body}"/>
                        <TextBlock Text="{c:T SetExportNote}" Style="{StaticResource CardDesc}"/>
                    </StackPanel>
                    <Button x:Name="exportBtn" Grid.Column="2" Style="{StaticResource StandardButton}" Content="{c:T SetExportButton}" Click="Export_Click"/>
                </Grid>
            </Border>

            <!-- About -->
            <TextBlock Text="{c:T SetAbout}" Style="{StaticResource GroupHeader}"/>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource CardGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image Source="{StaticResource AppIcon}" Width="24" Height="24" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Style="{StaticResource CardText}">
                        <TextBlock Text="SweaxClip" Style="{StaticResource Body}"/>
                        <TextBlock Style="{StaticResource CardDesc}">
                            <Run x:Name="version"/><Run Text=" · © 2026 Sweax Studios · MIT"/>
                        </TextBlock>
                        <TextBlock x:Name="memory" Style="{StaticResource CardDesc}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource StandardButton}" Click="Source_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{c:T SetSource}"/>
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="8,1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
