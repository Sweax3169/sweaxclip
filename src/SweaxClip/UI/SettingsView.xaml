<UserControl x:Class="SweaxClip.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SweaxClip.Core"
             Background="{StaticResource Bg0}">
    <UserControl.Resources>
        <Style x:Key="SectionNo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Display}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,60,0"/>
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,26,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="48,30,48,60" MaxWidth="900" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,26">
                <TextBlock Text="{c:T Settings, Upper=True}" Style="{StaticResource Display}" FontSize="38"/>
                <Button Style="{StaticResource Action}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Back_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static c:Glyphs.Back}" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{c:T Back}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 01 general -->
            <Border Style="{StaticResource Section}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="01" Style="{StaticResource SectionNo}"/>
                        <TextBlock Text="{c:T SetGeneral, Upper=True}" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="{c:T SetHotkey}" FontSize="13" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="hkWinV" Style="{StaticResource Segment}" GroupName="hk" Content="Win + V" Checked="Hotkey_Checked"/>
                                <RadioButton x:Name="hkCtrlShiftV" Style="{StaticResource Segment}" GroupName="hk" Content="Ctrl + Shift + V" Checked="Hotkey_Checked"/>
                                <RadioButton x:Name="hkCtrlAltV" Style="{StaticResource Segment}" GroupName="hk" Content="Ctrl + Alt + V" Checked="Hotkey_Checked"/>
                            </StackPanel>
                            <TextBlock Text="{c:T SetHotkeyNote}" Style="{StaticResource Note}" Margin="0,8,60,0"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="startup" Style="{StaticResource Toggle}" Content="{c:T SetStartup}" Click="Toggle_Click"/>
                            <TextBlock Text="{c:T SetStartupNote}" Style="{StaticResource Note}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="plain" Style="{StaticResource Toggle}" Content="{c:T SetPastePlain}" Click="Toggle_Click"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="toTop" Style="{StaticResource Toggle}" Content="{c:T SetMoveToTop}" Click="Toggle_Click"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="{c:T SetLanguage}" FontSize="13" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="langAuto" Style="{StaticResource Segment}" GroupName="lang" Content="{c:T SetLanguageAuto}" Checked="Lang_Checked"/>
                                <RadioButton x:Name="langEn" Style="{StaticResource Segment}" GroupName="lang" Content="English" Checked="Lang_Checked"/>
                                <RadioButton x:Name="langTr" Style="{StaticResource Segment}" GroupName="lang" Content="Türkçe" Checked="Lang_Checked"/>
                            </StackPanel>
                            <TextBlock Text="{c:T SetLanguageNote}" Style="{StaticResource Note}" Margin="0,8,60,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 02 capture -->
            <Border Style="{StaticResource Section}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="02" Style="{StaticResource SectionNo}"/>
                        <TextBlock Text="{c:T SetCapture, Upper=True}" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="capText" Style="{StaticResource Toggle}" Content="{c:T SetCaptureText}" Click="Toggle_Click"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="capImages" Style="{StaticResource Toggle}" Content="{c:T SetCaptureImages}" Click="Toggle_Click"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="capFiles" Style="{StaticResource Toggle}" Content="{c:T SetCaptureFiles}" Click="Toggle_Click"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="watch" Style="{StaticResource Toggle}" Content="{c:T SetWatchShots}" Click="Toggle_Click"/>
                            <TextBlock Text="{c:T SetWatchShotsNote}" Style="{StaticResource Note}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="importBtn" Style="{StaticResource Action}" Click="Import_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static c:Glyphs.Download}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{c:T SetImportShots}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="importStatus" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="ocr" Style="{StaticResource Toggle}" Content="{c:T SetOcr}" Click="Toggle_Click"/>
                            <TextBlock Text="{c:T SetOcrNote}" Style="{StaticResource Note}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="privacy" Style="{StaticResource Toggle}" Content="{c:T SetPrivacy}" Click="Toggle_Click"/>
                            <TextBlock Text="{c:T SetPrivacyNote}" Style="{StaticResource Note}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="{c:T SetIgnoredApps}" FontSize="13" Margin="0,0,0,10"/>
                            <TextBox x:Name="ignored" Style="{StaticResource FieldBox}" AcceptsReturn="True" Height="96" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                     VerticalScrollBarVisibility="Auto" LostKeyboardFocus="Ignored_LostFocus"/>
                            <TextBlock Text="{c:T SetIgnoredAppsNote}" Style="{StaticResource Note}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 03 storage -->
            <Border Style="{StaticResource Section}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="03" Style="{StaticResource SectionNo}"/>
                        <TextBlock Text="{c:T SetStorage, Upper=True}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Style="{StaticResource Row}">
                            <Border BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0" Padding="14,4" Background="{StaticResource AccentFaint}">
                                <TextBlock Text="{c:T SetRetention}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="{c:T SetDataFolder}" FontSize="13" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border BorderBrush="{StaticResource Line2}" BorderThickness="1" Background="{StaticResource Bg1}" Padding="10,0" Height="32">
                                    <TextBlock x:Name="dataPath" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource Action}" Margin="8,0,0,0" Click="OpenFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static c:Glyphs.Folder}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{c:T SetOpenFolder}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="dataStats" Style="{StaticResource Mono}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox x:Name="backups" Style="{StaticResource Toggle}" Content="{c:T SetBackups}" Click="Toggle_Click"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource Action}" Click="BackupNow_Click" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static c:Glyphs.Database}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{c:T SetBackupNow}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="exportBtn" Style="{StaticResource Action}" Click="Export_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static c:Glyphs.Save}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{c:T SetExport}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="backupStatus" Style="{StaticResource Mono}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 04 about -->
            <Border Style="{StaticResource Section}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="04" Style="{StaticResource SectionNo}"/>
                        <TextBlock Text="{c:T SetAbout, Upper=True}" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Image Source="{StaticResource Mark}" Width="64" Height="64" VerticalAlignment="Top"/>
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Style="{StaticResource Display}" FontSize="30"><Run Text="SWEAX"/><Run Text="CLIP" Foreground="{StaticResource Accent}"/></TextBlock>
                            <TextBlock Text="{c:T AppTagline}" Foreground="{StaticResource Text2}" FontSize="13" Margin="0,2,0,0"/>
                            <TextBlock x:Name="version" Style="{StaticResource Mono}" Margin="0,10,0,0"/>
                            <TextBlock x:Name="memory" Style="{StaticResource Mono}" Margin="0,4,0,0"/>
                            <TextBlock Margin="0,12,0,0">
                                <Hyperlink NavigateUri="https://github.com/Sweax3169/sweaxclip" RequestNavigate="Link_Navigate" Foreground="{StaticResource Accent}" TextDecorations="None">
                                    <Run Text="{c:T SetSource}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                                    <Run Text=" ↗" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="© 2026 Sweax Studios · MIT" Style="{StaticResource Mono}" Margin="0,12,0,0" Foreground="{StaticResource Text4}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
