<Window x:Class="SweaxClip.UI.DeckPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SweaxClip.Core"
        xmlns:ui="clr-namespace:SweaxClip.UI"
        Title="SweaxClip" Width="460" Height="630"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000" ShowActivated="True">

    <Grid x:Name="root" Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- the lid: search and the shelf of object categories -->
        <Border x:Name="lid" Background="{DynamicResource ChipFill}" CornerRadius="18" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10"
                Effect="{StaticResource FloatShadow}" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform><TransformGroup><TranslateTransform x:Name="lidShift"/><TranslateTransform x:Name="lidFollow"/></TransformGroup></Border.RenderTransform>
            <StackPanel>
                <TextBox x:Name="search" Style="{StaticResource SearchField}" Background="{DynamicResource Surface2}" Tag="{c:T SearchHintShort}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MinHeight="42"/>
                <Grid Margin="2,10,2,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding Scopes}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type c:ScopeInfo}">
                                <Button x:Name="tab" Style="{StaticResource GhostButton}" Width="34" Height="38" Padding="0" Margin="0,0,1,0" Focusable="False" ToolTip="{Binding Label}"
                                        Command="{x:Static ui:Cmds.SetScope}" CommandParameter="{Binding Scope}">
                                    <Grid>
                                        <Image x:Name="icon" Source="{Binding Icon}" Width="22" Height="22" Opacity="0.72" RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform><ScaleTransform x:Name="pop"/></Image.RenderTransform>
                                        </Image>
                                        <Ellipse x:Name="dot" Width="5" Height="5" Fill="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="0,0,0,-4" Visibility="Hidden"/>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Active}" Value="True">
                                        <Setter TargetName="icon" Property="Opacity" Value="1"/>
                                        <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="tab" Property="Background" Value="{DynamicResource Surface2}"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="pop" Storyboard.TargetProperty="ScaleX" From="0.7" To="1" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="pop" Storyboard.TargetProperty="ScaleY" From="0.7" To="1" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                        <TextBlock Text="{Binding ScopeTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="count" FontSize="11.5" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- the deck -->
        <ui:Deck x:Name="deck" Grid.Row="1" Margin="0,14,0,0"/>

        <StackPanel x:Name="empty" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,6" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Width="392" Height="232" CornerRadius="14" BorderBrush="{DynamicResource Line2}" BorderThickness="1.5" Background="{DynamicResource ChipFill}">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="{StaticResource Obj.Stack}" Width="54" Height="54" Opacity="0.85"/>
                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                    <TextBlock Text="{Binding EmptyBody}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="40,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- hints -->
        <Border x:Name="hints" Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,0" Background="{DynamicResource ChipFill}" CornerRadius="10" Padding="12,6"
                BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Border.RenderTransform><TranslateTransform x:Name="hintsFollow"/></Border.RenderTransform>
            <StackPanel Orientation="Horizontal" TextElement.FontSize="11.5" TextElement.Foreground="{DynamicResource Ink2}">
                <Border Style="{StaticResource Keycap}"><TextBlock Text="↑↓" Foreground="{DynamicResource Ink}"/></Border>
                <TextBlock Text="{c:T HintBrowse}" Margin="6,0,12,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Foreground="{DynamicResource Ink}"/></Border>
                <TextBlock Text="{c:T HintPaste}" Margin="6,0,12,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Keycap}"><TextBlock Text="Tab" Foreground="{DynamicResource Ink}"/></Border>
                <TextBlock Text="{c:T HintTabs}" Margin="6,0,12,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Keycap}"><TextBlock Text="Alt" Foreground="{DynamicResource Ink}"/></Border>
                <TextBlock Text="1–9" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border x:Name="pausedBadge" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" Background="{DynamicResource Accent}" CornerRadius="8"
                Padding="10,4" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="{c:T Paused}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}"/>
        </Border>

        <Border x:Name="toast" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0" Background="{DynamicResource Ink}" CornerRadius="10"
                Padding="14,7,14,8" Opacity="0" IsHitTestVisible="False" Effect="{StaticResource LiftShadow}">
            <TextBlock x:Name="toastText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Desk}"/>
        </Border>
    </Grid>
</Window>
